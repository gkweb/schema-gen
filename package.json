{
  "name": "schema-gen-workspace",
  "private": true,
  "packageManager": "pnpm@9.14.2",
  "scripts": {
    "build": "pnpm -r build",
    "build:rust": "cargo build --release",
    "build:binding": "pnpm --filter @schema-gen/core build:binding",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "test:rust": "cargo test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean && cargo clean",
    "prepare": "pnpm build:binding"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  }
}
