{
  "name": "schema-gen-workspace",
  "private": true,
  "packageManager": "pnpm@9.14.2",
  "scripts": {
    "build": "pnpm -r build",
    "build:rust": "cargo build --release",
    "build:binding": "pnpm --filter @schema-gen/core build:binding",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm --filter './packages/*' test",
    "test:rust": "cargo test",
    "lint": "oxlint --config oxlint.json packages/",
    "lint:fix": "oxlint --config oxlint.json --fix packages/",
    "format": "prettier --write \"packages/**/*.{ts,tsx,js,json}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,js,json}\"",
    "typecheck": "pnpm --filter './packages/*' typecheck",
    "clean": "pnpm -r clean && cargo clean",
    "schema-gen": "node packages/cli/dist/bin.mjs",
    "docs:dev": "pnpm --filter @schema-gen/docs dev",
    "docs:build": "pnpm --filter @schema-gen/docs build",
    "docs:preview": "pnpm --filter @schema-gen/docs preview",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "build:packages": "pnpm --filter './packages/*' build",
    "release": "pnpm build:packages && pnpm --filter @schema-gen/core artifacts && pnpm --filter @schema-gen/core prepublish:napi && pnpm changeset:publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.5.2",
    "@changesets/cli": "2.29.8",
    "@types/node": "22.10.0",
    "oxlint": "0.15.0",
    "prettier": "3.4.2",
    "typescript": "5.7.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  }
}
