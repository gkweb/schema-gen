{
  "name": "@schema-gen/cli",
  "version": "0.2.1",
  "type": "module",
  "description": "CLI for schema-gen - OpenAPI to TypeScript/React Query/Vue Query code generation",
  "bin": {
    "schema-gen": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@schema-gen/core": "workspace:*",
    "cac": "6.7.14",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "@types/node": "22.10.0",
    "tsdown": "0.16.8",
    "typescript": "5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "openapi",
    "codegen",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gkweb/schema-gen"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
