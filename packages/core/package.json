{
  "name": "@schema-gen/core",
  "version": "0.1.0",
  "type": "module",
  "description": "High-performance OpenAPI to TypeScript/React Query/Vue Query code generation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "*.node"
  ],
  "napi": {
    "name": "schema-gen",
    "triples": {
      "defaults": true,
      "additional": [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "aarch64-unknown-linux-musl",
        "x86_64-unknown-linux-musl",
        "aarch64-pc-windows-msvc"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:binding": "napi build --platform --release --strip ../../crates/schema-gen-binding",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.node",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "cosmiconfig": "9.0.0"
  },
  "devDependencies": {
    "@napi-rs/cli": "2.18.4",
    "@types/node": "22.10.0",
    "tsdown": "0.16.8",
    "typescript": "5.7.2",
    "vitest": "2.1.6"
  },
  "optionalDependencies": {
    "@schema-gen/binding-darwin-arm64": "0.1.0",
    "@schema-gen/binding-darwin-x64": "0.1.0",
    "@schema-gen/binding-linux-arm64-gnu": "0.1.0",
    "@schema-gen/binding-linux-arm64-musl": "0.1.0",
    "@schema-gen/binding-linux-x64-gnu": "0.1.0",
    "@schema-gen/binding-linux-x64-musl": "0.1.0",
    "@schema-gen/binding-win32-arm64-msvc": "0.1.0",
    "@schema-gen/binding-win32-x64-msvc": "0.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "openapi",
    "swagger",
    "codegen",
    "typescript",
    "react-query",
    "vue-query",
    "tanstack-query"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gkweb/schema-gen"
  }
}
