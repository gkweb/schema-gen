{
  "name": "@schema-gen/plugin-sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "SDK for creating schema-gen plugins",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@schema-gen/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.10.0",
    "tsdown": "0.16.8",
    "typescript": "5.7.2"
  },
  "keywords": [
    "openapi",
    "codegen",
    "plugin",
    "sdk"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gkweb/schema-gen"
  }
}
