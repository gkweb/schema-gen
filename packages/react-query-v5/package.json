{
  "name": "@schema-gen/plugin-react-query-v5",
  "version": "0.1.0",
  "type": "module",
  "description": "React Query v5 plugin for schema-gen - generates TanStack React Query hooks",
  "main": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@schema-gen/plugin-sdk": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "22.10.0",
    "tsdown": "0.16.8",
    "typescript": "5.7.2",
    "vitest": "2.1.6"
  },
  "keywords": [
    "openapi",
    "codegen",
    "plugin",
    "react-query",
    "tanstack-query",
    "react"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gkweb/schema-gen"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
